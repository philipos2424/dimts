# ---- Backend (server/) ----
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_NUMBER=+1xxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=xxxx
OPENAI_API_KEY=sk-xxxx
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
# Ollama Cloud: set OLLAMA_BASE_URL=https://ollama.com and
# OLLAMA_MODEL=gemma4:31b, then add your server-only cloud key here.
OLLAMA_API_KEY=
TRANSCRIBE_PROVIDER=whisper
WHISPER_BASE_URL=http://127.0.0.1:3104
WHISPER_API_TOKEN=replace-with-a-random-local-token
WHISPER_MODEL=base

# Supabase transaction pooler (port 6543), NOT the direct 5432 host.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For local testing without a hosted database, set DATABASE_MODE=local.
# The server persists PostgreSQL data in the ignored .data/ directory.
DATABASE_MODE=postgres

# Public HTTPS origin Twilio calls back on. Use the ngrok static domain in dev,
# the Vercel deployment URL in production. No trailing slash.
PUBLIC_BASE_URL=https://<your-static>.ngrok-free.app

# ---- Mobile app (Expo) ----
# Must be reachable from the device. EXPO_PUBLIC_ vars are inlined at build time.
EXPO_PUBLIC_API_BASE_URL=https://<your-static>.ngrok-free.app
