# ---- Backend (server/) ----
# Voice and sign-in codes: CARRIER=telnyx uses the TELNYX_* settings, otherwise Twilio.
CARRIER=
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_APP_ID=
TELNYX_VERIFY_PROFILE_ID=
TELNYX_PUBLIC_KEY=
TELNYX_NUMBER=
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
# Recommended: a Standard API key for REST calls (the auth token stays for webhook signatures)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_NUMBER=+1xxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Business numbers: bought automatically when the pool is empty (NUMBER_AUTOBUY=off stops that).
# NUMBER_COUNTRIES lists ISO codes to buy in; add GB/EU only after the carrier approves address requirements.
NUMBER_AUTOBUY=
NUMBER_COUNTRIES=US
NUMBER_AUTOBUY_DAILY_MAX=20
ELEVENLABS_API_KEY=xxxx
OPENAI_API_KEY=sk-xxxx
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
# Ollama Cloud: set OLLAMA_BASE_URL=https://ollama.com and
# OLLAMA_MODEL=gemma4:31b, then add your server-only cloud key here.
OLLAMA_API_KEY=
# Server-only Google OAuth. Redirect must end in /oauth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# 32 random bytes encoded as 64 hex characters. Back up this key securely.
INTEGRATION_ENCRYPTION_KEY=
TRANSCRIBE_PROVIDER=whisper
WHISPER_BASE_URL=http://127.0.0.1:3104
WHISPER_API_TOKEN=replace-with-a-random-local-token
WHISPER_MODEL=base

# Supabase transaction pooler (port 6543), NOT the direct 5432 host.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For local testing without a hosted database, set DATABASE_MODE=local.
# The server persists PostgreSQL data in the ignored .data/ directory.
DATABASE_MODE=postgres

# Public HTTPS origin Twilio calls back on. Use the ngrok static domain in dev,
# the Vercel deployment URL in production. No trailing slash.
PUBLIC_BASE_URL=https://<your-static>.ngrok-free.app

# Call circuit breakers. Pending/uncertain calls reserve their maximum
# duration (up to 30 minutes). Plan minutes and credits (server/lib/pricing.js)
# decide what each user may call; GLOBAL_CALL_MINUTES_PER_MONTH caps the
# minutes all Free-plan users can use together in a month (paid plans and
# credits are never held by it). Raise it as the Free plan grows.
CALLS_PER_DAY=10
GLOBAL_CALL_MINUTES_PER_MONTH=300

# ---- Payments (Polar, merchant of record) ----
# Leave all three empty to run without payments (plans can't be bought).
# POLAR_SERVER=sandbox uses sandbox-api.polar.sh with sandbox tokens.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
# Webhook endpoint: ${PUBLIC_BASE_URL}/webhooks/polar, events: order.paid,
# order.refunded, subscription.* . Paste its whsec_ secret here.
POLAR_WEBHOOK_SECRET=
# Printed by: node --env-file=../.env server/scripts/polar-setup.js
POLAR_PRODUCTS=


# Optional server-only Expo Push Security access token. Required when enhanced
# push security is enabled for the EAS project. Never use EXPO_PUBLIC_ here.
EXPO_ACCESS_TOKEN=

# ---- Mobile app (Expo) ----
# Must be reachable from the device. EXPO_PUBLIC_ vars are inlined at build time.
EXPO_PUBLIC_API_BASE_URL=https://<your-static>.ngrok-free.app

# EU audio storage (Supabase Storage, server-only secret key; never EXPO_PUBLIC_).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AUDIO_BUCKET=call-audio
# Salt for hashing IP addresses in the audit log. Required in production: 32+ random characters.
AUDIT_SALT=
# Encrypts call content and audio before storage: "id:base64key[,id:base64key]".
# The first key encrypts; every listed key can still decrypt (rotation).
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
# Required in production. Losing every copy of a key makes the data it sealed unreadable:
# keep a backup in a password manager, separate from the database.
DATA_ENCRYPTION_KEYS=
# Monday 13:00 UTC weekly briefing push (Vercel Cron sends it as a Bearer token). 16+ random characters.
CRON_SECRET=

# App Store / Play review account. Both must be set to switch it on. Signing in
# with this number and code skips SMS and loads sample calls; the number never
# reaches the carrier. Use a fictional 555-01xx number and a fresh 6-10 digit code.
REVIEW_DEMO_PHONE=
REVIEW_DEMO_CODE=

# Operator console at /admin/. Comma-separated E.164 numbers of staff who may
# open it after signing in to the web app with that number. Empty = no one.
ADMIN_PHONES=
# One-time setup link for the first passkey, no text or call: "<staff phone>:<64 hex>".
# Open /admin/#setup=<64 hex>. Works once; set a new value for a new link.
ADMIN_SETUP_TOKEN=
