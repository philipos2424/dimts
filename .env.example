# ---- Backend (server/) ----
# Voice and sign-in codes: CARRIER=telnyx uses the TELNYX_* settings, otherwise Twilio.
CARRIER=
TELNYX_API_KEY=
TELNYX_ACCOUNT_SID=
TELNYX_TEXML_APP_ID=
TELNYX_VERIFY_PROFILE_ID=
TELNYX_PUBLIC_KEY=
TELNYX_NUMBER=
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
# Recommended: a Standard API key for REST calls (the auth token stays for webhook signatures)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_NUMBER=+1xxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=xxxx
OPENAI_API_KEY=sk-xxxx
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
# Ollama Cloud: set OLLAMA_BASE_URL=https://ollama.com and
# OLLAMA_MODEL=gemma4:31b, then add your server-only cloud key here.
OLLAMA_API_KEY=
# Server-only Google OAuth. Redirect must end in /oauth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# 32 random bytes encoded as 64 hex characters. Back up this key securely.
INTEGRATION_ENCRYPTION_KEY=
TRANSCRIBE_PROVIDER=whisper
WHISPER_BASE_URL=http://127.0.0.1:3104
WHISPER_API_TOKEN=replace-with-a-random-local-token
WHISPER_MODEL=base

# Supabase transaction pooler (port 6543), NOT the direct 5432 host.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# For local testing without a hosted database, set DATABASE_MODE=local.
# The server persists PostgreSQL data in the ignored .data/ directory.
DATABASE_MODE=postgres

# Public HTTPS origin Twilio calls back on. Use the ngrok static domain in dev,
# the Vercel deployment URL in production. No trailing slash.
PUBLIC_BASE_URL=https://<your-static>.ngrok-free.app

# Pilot call circuit breaker: both incoming and outgoing calls share these limits.
# Pending/uncertain calls reserve their maximum duration (up to 30 minutes).
# These bound connected minutes, not currency spend or SMS/number charges.
CALLS_PER_DAY=10
CALL_MINUTES_PER_MONTH=120
GLOBAL_CALL_MINUTES_PER_MONTH=300


# Optional server-only Expo Push Security access token. Required when enhanced
# push security is enabled for the EAS project. Never use EXPO_PUBLIC_ here.
EXPO_ACCESS_TOKEN=

# ---- Mobile app (Expo) ----
# Must be reachable from the device. EXPO_PUBLIC_ vars are inlined at build time.
EXPO_PUBLIC_API_BASE_URL=https://<your-static>.ngrok-free.app

# EU audio storage (Supabase Storage, server-only secret key; never EXPO_PUBLIC_).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AUDIO_BUCKET=call-audio
# Salt for hashing IP addresses in the audit log.
AUDIT_SALT=
