# Copy to .env.pilot.local at the repository root; that file is ignored.
# Generate independent random 64-hex-character values for the three keys below.
# Hex-only POSTGRES_PASSWORD avoids URI/Compose interpolation ambiguity.
POSTGRES_PASSWORD=
WHISPER_API_TOKEN=
INTEGRATION_ENCRYPTION_KEY=
WHISPER_MODEL=base
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Recommended: a Standard API key for REST calls (the auth token stays for webhook signatures)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
PUBLIC_BASE_URL=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
EXPO_ACCESS_TOKEN=
CALLS_PER_DAY=10
CALL_MINUTES_PER_MONTH=120
GLOBAL_CALL_MINUTES_PER_MONTH=300
DIMTS_HTTP_PORT=3103
