{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "fra1"
  ],
  "installCommand": "npm ci && npm ci --prefix server",
  "buildCommand": "node server/scripts/check-ai-build.js && npx expo export --platform web --output-dir dist",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "server/{db/supabase-ca.crt,admin/**}"
    }
  },
  "routes": [
    {
      "src": "/(?!(?:api|twiml|webhooks|oauth|admin)(?:/|$)|health$).*",
      "headers": {
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(), geolocation=(), microphone=()",
        "Content-Security-Policy": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://*.ingest.de.sentry.io; frame-ancestors 'none'"
      },
      "continue": true
    },
    {
      "src": "/(?:api|twiml|webhooks|oauth|admin)(?:/.*)?",
      "dest": "/api/index"
    },
    {
      "src": "/health",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?:onboarding|first-call|demo-call|settings|dialer|ask|calls|in-call|privacy|terms|privacy-request|subprocessors|terms-accept|plans)",
      "dest": "/index.html"
    },
    {
      "src": "/call/[^/]+",
      "dest": "/index.html"
    },
    {
      "src": "/person/[^/]+",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/weekly-briefing",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "30 2 * * *"
    }
  ]
}
