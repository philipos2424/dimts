{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": ["fra1"],
  "installCommand": "npm ci && npm ci --prefix server",
  "buildCommand": "node server/scripts/check-ai-build.js && npx expo export --platform web --output-dir dist",
  "outputDirectory": "dist",
  "functions": { "api/index.js": { "maxDuration": 300, "includeFiles": "server/db/supabase-ca.crt" } },
  "routes": [
    { "src": "/(?:api|twiml|webhooks|oauth)(?:/.*)?", "dest": "/api/index" },
    { "src": "/health", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(?:onboarding|first-call|settings|dialer|contacts|notes|in-call)", "dest": "/index.html" },
    { "src": "/call/[^/]+", "dest": "/index.html" }
  ]
}
